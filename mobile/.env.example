# Backend API
EXPO_PUBLIC_API_URL=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Shell Obsidian: "1" o "true" per instradare i tab alle schermate Obsidian.
EXPO_PUBLIC_OBSIDIAN_SHELL=

# Sentry (progetto react-native)
# Il DSN finisce nel bundle dell'app: è pubblico per natura, non è un segreto.
# Attivo SOLO nelle build di produzione — con __DEV__ non parte nulla, quindi in
# `expo start` non vedrai mai un evento.
EXPO_PUBLIC_SENTRY_DSN=
# Etichetta dell'ambiente su Sentry. Se vuoto ricade su "production".
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# ─── Solo in fase di BUILD (EAS), non a runtime ──────────────────────────────
# Servono al caricamento delle source map. Senza, gli errori arrivano lo stesso
# ma con stack trace illeggibili.
# ⚠️ SENTRY_AUTH_TOKEN è un SEGRETO VERO: va creato con `eas secret:create`,
# MAI scritto in eas.json (che è versionato).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
