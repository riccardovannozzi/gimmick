# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT (optional - if using custom auth)
JWT_SECRET=your_jwt_secret

# CORS
CORS_ORIGIN=http://localhost:8081

# Sentry (progetto gimmick-api)
# Attivo SOLO con NODE_ENV=production: in sviluppo non parte nulla anche col DSN.
SENTRY_DSN=
# Etichetta dell'ambiente su Sentry. Se vuoto ricade su NODE_ENV.
SENTRY_ENVIRONMENT=
