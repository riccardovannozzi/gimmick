# Backend API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Sentry (progetto gimmick-web)
# Il DSN finisce nel bundle del browser: è pubblico per natura, non è un segreto.
# Attivo SOLO con NODE_ENV=production — in `next dev` non parte nulla.
NEXT_PUBLIC_SENTRY_DSN=
# Etichetta dell'ambiente su Sentry. Se vuoto ricade su NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Caricamento delle source map in fase di BUILD (non a runtime).
# SENTRY_AUTH_TOKEN è un SEGRETO VERO: va nelle variabili di Railway, mai in un
# file versionato. Senza, la build funziona ma gli stack trace restano minificati.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
