# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tranne il modello delle variabili, che deve stare nel repo: `.env*` sopra
# lo catturava, e il file esisteva solo sulla macchina di chi l'aveva scritto.
!.env.example

# vercel
.vercel

# Sentry
.sentryclirc

# typescript
*.tsbuildinfo
next-env.d.ts
